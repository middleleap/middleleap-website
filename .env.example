# Plausible Analytics domain (e.g. www.middleleap.com). Leave unset to disable analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional ownership tokens used for webmaster-tool verification.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Venture Studio proposal endpoint (functions/api/propose.ts). These are NOT read
# from .env: set them as secrets on the Cloudflare Pages project. Without
# RESEND_API_KEY the endpoint answers 503 and the form falls back to mailto.
# RESEND_API_KEY=
# PROPOSAL_TO=contact@middleleap.com
# PROPOSAL_FROM=MiddleLeap Venture Studio <studio@middleleap.com>
