# Markdown twins of each page, written by scripts/build-markdown.mjs. Agents
# normally reach them through `Accept: text/markdown` on the page URL
# (functions/_middleware.ts); the direct .md URLs stay out of search indexes.
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

# Security headers for every response. Scripts run only from this origin, from
# Plausible analytics, or when they are one of the inline scripts the export
# itself contains: scripts/build-csp.mjs replaces __INLINE_SCRIPT_HASHES__ with
# their SHA-256 hashes at the end of every build, so no other inline script can
# run. Inline <style> elements are refused; style attributes are allowed because
# next/image writes one. Cloudflare Web Analytics is enabled on the zone and
# injects its beacon at the edge: static.cloudflareinsights.com serves the
# script and cloudflareinsights.com receives its reports.
# HSTS deliberately omits includeSubDomains: other hosts under middleleap.com
# are served from different platforms.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' __INLINE_SCRIPT_HASHES__ https://plausible.io https://static.cloudflareinsights.com; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' https://plausible.io https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
